				{
					"name": "5.3 VNPay Webhook IPN Callback - Success 00",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var txnRef = pm.collectionVariables.get('vnp_txn_ref') || 'PAY_SAMPLE_001';",
									"var secretKey = pm.collectionVariables.get('vnp_hash_secret') || 'sandbox_vnpay_hash_secret_placeholder';",
									"var amount = '300000000';",
									"var responseCode = '00';",
									"var transactionNo = '14567890';",
									"var rawParams = {",
									"    'vnp_Amount': amount,",
									"    'vnp_BankCode': 'NCB',",
									"    'vnp_CardType': 'ATM',",
									"    'vnp_OrderInfo': 'Thanh toan ve tau',",
									"    'vnp_PayDate': '20261122150000',",
									"    'vnp_ResponseCode': responseCode,",
									"    'vnp_TmnCode': 'TMNCODE1',",
									"    'vnp_TransactionNo': transactionNo,",
									"    'vnp_TransactionStatus': responseCode,",
									"    'vnp_TxnRef': txnRef",
									"};",
									"var sortedKeys = Object.keys(rawParams).sort();",
									"var hashData = sortedKeys.map(function(k) {",
									"    return k + '=' + encodeURIComponent(rawParams[k]).replace(/%20/g, '+');",
									"}).join('&');",
									"var hash = CryptoJS.HmacSHA512(hashData, secretKey).toString();",
									"pm.variables.set('dyn_vnp_txn_ref', txnRef);",
									"pm.variables.set('dyn_vnp_amount', amount);",
									"pm.variables.set('dyn_vnp_response_code', responseCode);",
									"pm.variables.set('dyn_vnp_trans_no', transactionNo);",
									"pm.variables.set('dyn_vnp_secure_hash', hash);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test(\"VNPay IPN processed successfully with RspCode 00\", function () {",
									"    pm.expect(jsonData.RspCode).to.eql(\"00\");",
									"    pm.expect(jsonData.Message).to.eql(\"Confirm Success\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
