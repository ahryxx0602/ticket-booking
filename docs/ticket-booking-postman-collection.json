		{
			"name": "4. Booking & Admin Refund (PHASE-03)",
			"item": [
				{
					"name": "4.1 Hold Seat (Owner-Token Redis Lock 10m & Catalog Pricing)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
									"var json = pm.response.json();",
									"pm.test('Booking is HELD with positive totalAmount', function () {",
									"    pm.expect(json.success).to.eql(true);",
									"    pm.expect(json.data.status).to.eql('HELD');",
									"    pm.expect(json.data.totalAmount).to.be.above(0);",
									"});",
									"if (json.data && json.data.bookingReference) {",
									"    pm.collectionVariables.set('booking_ref', json.data.bookingReference);",
									"}"
								],
								"type": "text/javascript"
							}
