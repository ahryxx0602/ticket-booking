# ==============================================================================
# TICKET BOOKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- DATABASE CONFIGURATION (MySQL 8.4) ---
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=ticket_booking_db
MYSQL_USER=ticket_user
MYSQL_PASSWORD=ticket_password
MYSQL_ROOT_PASSWORD=root_password

# --- CACHE & DISTRIBUTED LOCK CONFIGURATION (Redis 7.2) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SECURITY & JWT CONFIGURATION ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# --- PAYMENT GATEWAY (VNPay Sandbox) ---
VNPAY_HASH_SECRET=your_vnpay_sandbox_hash_secret_placeholder
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
