# ==============================================================================
# TICKET BOOKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env

# --- SPRING BOOT & APPLICATION PORTS ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
FRONTEND_PORT=5173

# --- DATABASE CONFIGURATION (MySQL 8.4) ---
# Note: Host port defaults to 3307 to avoid Windows host MySQL 3306 conflict (ADR-01)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=ticket_booking_db
MYSQL_USER=ticket_user
MYSQL_PASSWORD=ticket_password
MYSQL_ROOT_PASSWORD=root_password

# --- CACHE & DISTRIBUTED LOCK CONFIGURATION (Redis 7.2) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- SECURITY & JWT CONFIGURATION ---
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_for_hmac_sha256
JWT_EXPIRATION_MS=86400000

# --- PAYMENT GATEWAY (VNPay Sandbox) ---
VNPAY_HASH_SECRET=your_vnpay_sandbox_hash_secret_placeholder
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- OPTIONAL NOTIFICATIONS (Disabled by default in local dev) ---
TELEGRAM_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_minimum_16_chars
QR_SECRET_KEY=your_qr_signing_secret_key_minimum_32_characters_long
MAIL_ENABLED=false
FIREBASE_ENABLED=false
